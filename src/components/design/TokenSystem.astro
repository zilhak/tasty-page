---
/** `/design/tokens/`: the token specimen. It renders without client:load, so the token JSON stays out of the browser. */
import SpecimenPage from "./SpecimenPage.astro";
import Route, { page } from "../../../vendor/gallery/tokens/index.jsx";

interface Props { lang: string; }
const { lang } = Astro.props;

const DESCRIPTION = "Tasty’s design tokens link primitive values, semantic roles and component parts. Rows show names, references and values for Mocha and Latte.";
---
<SpecimenPage lang={lang} pageKey="tokens" page={page} description={DESCRIPTION}>
  <Route />
</SpecimenPage>
