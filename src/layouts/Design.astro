---
/** The design zone's one layout: the home, the tokens and the gallery. The site header and footer follow the page's language. The menu and previous/next are English in every language. */
import Base from "./Base.astro";
import { DESIGN_GROUPS, DESIGN_LANG, DESIGN_MENU_LABEL, DESIGN_PAGES, PAGE_NAV_LABELS, designPage, designPath, isIndexed } from "../lib/design";
import { LANGS } from "../lib/langs.mjs";
import { url } from "../lib/site";
import "../styles/design.css";

interface Props {
  /** A language code from lib/langs.mjs. */
  lang: string;
  /** Key of the page being rendered, from lib/design.ts. */
  pageKey: string;
  title: string;
  /** Lead paragraph on the page. */
  intro: string;
  /** Plain-text search and share summary, kept apart from the longer intro. */
  description: string;
  /** Sections of the current page, listed under it in the menu. */
  sections?: { id: string; label: string }[];
}
const { lang, pageKey, title, intro, description, sections = [] } = Astro.props;
const current = designPage(pageKey);
const idx = DESIGN_PAGES.indexOf(current);
const prev = DESIGN_PAGES[idx - 1];
const next = DESIGN_PAGES[idx + 1];
---
<Base
  lang={lang}
  title={`${title} · ${current.titleSuffix}`}
  description={description}
  active="design"
  hrefs={Object.fromEntries(LANGS.map((row) => [row.code, designPath(current.slug, row.code)]))}
  robots={isIndexed(current, lang) ? undefined : "noindex, follow"}
  announceLanguages={current.translated}
>
  <slot name="head" slot="head" />
  <div class="layout layout--design">
    <aside class="sidebar" aria-label={DESIGN_MENU_LABEL} lang={DESIGN_LANG} data-site-chrome>
      {DESIGN_GROUPS.map((group) => (
        <details class="nav-section" open data-current={group.pages.includes(current) ? "" : undefined}>
          <summary>{group.group}</summary>
          <ul class="nav-list">
            {group.pages.map((item) => (
              <li>
                <a href={url(designPath(item.slug, lang))} aria-current={item === current ? "page" : undefined} style="--indent:0">{item.label}</a>
                {item === current && sections.length > 0 && (
                  <ul class="nav-list nav-list--sections">
                    {sections.map((n) => <li><a href={`#${n.id}`} style="--indent:1">{n.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </details>
      ))}
    </aside>
    <main class="content" id="content" lang={current.translated ? undefined : DESIGN_LANG}>
      <header class="design-head">
        <h1>{title}</h1>
        <p class="design-head__intro">{intro}</p>
      </header>
      <slot />
      <nav class="page-nav" lang={DESIGN_LANG} data-site-chrome>
        {prev && <a class="prev" href={url(designPath(prev.slug, lang))}><span class="dir">← {PAGE_NAV_LABELS.prev}</span>{prev.label}</a>}
        {next && <a class="next" href={url(designPath(next.slug, lang))}><span class="dir">{PAGE_NAV_LABELS.next} →</span>{next.label}</a>}
      </nav>
    </main>
  </div>
</Base>
