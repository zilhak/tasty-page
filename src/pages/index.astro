---
import Base from "../layouts/Base.astro";
import Landing from "../components/Landing.astro";
import { dictionaryFor } from "../lib/i18n/index.mjs";
import { url } from "../lib/site";
import { landingJsonLd } from "../lib/structured-data";

const meta = dictionaryFor("en").meta;
const korean = url("ko/");
---
<Base lang="en" title={meta.title} description={meta.description} hrefs={{ en: "", ko: "ko/" }}>
  <Fragment slot="head">
    <meta name="naver-site-verification" content="5da8d0987466907d092c6f94e26364e785acf65b" />
    <link rel="stylesheet" href={url("design/kit.css")} />
    <script is:inline type="application/ld+json" set:html={landingJsonLd("en")} />
    <script is:inline define:vars={{ korean }}>
      /* Runs before first paint. A saved choice outranks the browser language. */
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("tasty-lang"); } catch (e) { /* private mode */ }
        var language = saved || navigator.language || "";
        if (language.toLowerCase().indexOf("ko") === 0) {
          location.replace(korean + location.search + location.hash);
        }
      })();
    </script>
  </Fragment>
  <Landing lang="en" />
</Base>
