{
  "_about": "Canonical Tasty icon set. SOURCE OF TRUTH = the individual files in icons/<name>.svg (one 24x24 currentColor glyph each). This JSON is the machine-readable manifest generated from those files; the DS Icon component (components/core/Icon.jsx) embeds the same registry so UI renders a glyph by name (<Icon name=\"close\"/>) with no inline SVG. Regenerate this file and Icon.jsx's ICON_PATHS whenever an icons/*.svg is added or changed. No color/size is baked into a glyph: color = currentColor from the wrapping control, size = the size prop / control CSS.",
  "_pathsFormat": "Each icon's `paths` is an array of raw SVG child element strings (mostly <path>, plus <circle>/<rect> where a glyph needs them). Reconstruct an icon by wrapping the joined children: <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{paths.join('')}</svg>. Names, groups, and roles mirror gallery/icons.jsx exactly.",
  "iconSystem": {
    "viewBox": "0 0 24 24",
    "stroke": 2,
    "linecap": "round",
    "linejoin": "round",
    "fill": "none — DEFAULT (stroke glyphs). Per-glyph override via the entry's `fill` boolean.",
    "color": "currentColor",
    "sizes": [
      26,
      20,
      16,
      14,
      12
    ],
    "defaultSize": 16
  },
