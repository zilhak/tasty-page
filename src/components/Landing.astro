---

import { dictionaryFor } from "../lib/i18n/index.mjs";
import { langRow } from "../lib/langs.mjs";
import { copyFor } from "../lib/landing";
import { downloads, RELEASES_URL } from "../lib/release";
import { REPO, url } from "../lib/site";
import { releaseVersion } from "../lib/release";
import { Icon } from "../../vendor/components/core/Icon.jsx";
import { AppShell } from "./AppShell.jsx";
import { WorkflowLayout } from "./diagrams/WorkflowLayout.jsx";
import * as icon from "./icons";
import "../styles/app-shell.css";
import "../styles/landing.css";

interface Props { lang: string }
const { lang } = Astro.props;
const c = copyFor(lang);
const version = releaseVersion(process.cwd());
const guide = langRow(lang).guide;
const install = `${guide}getting-started/install/`;
const { items } = downloads(process.cwd());

// `site.js` swaps the primary button to the visitor's own OS and architecture
// when the release carries an asset for both. Without a match, or when the
// browser does not report the architecture, the button keeps the releases page.
const dataAttrs = Object.fromEntries(
  items.filter((d) => d.href).map((d) => [`data-${d.platform}-${d.arch}`, d.href!]),
);
---
<main class="landing" id="content">

  <section class="hero">
    <span class="hero__eyebrow"><span class="dot"></span>{c.badge}{version && ` · v${version}`}</span>
    <p class="hero__tagline"><span class="wordmark">Tasty<b data-audit-exempt="brand">.</b></span> {c.tagline}</p>
    <h1>{c.titleLead}<span class="accent">{c.titleAccent}</span>{c.titleTail}</h1>
    <p class="hero__body">{c.body}</p>
    <div class="cta-row">
      <a class="btn btn--primary" id="dl-primary" href={RELEASES_URL}
         data-label={c.dlFor} {...dataAttrs}>{c.ctaPrimary}</a>
      <a class="btn btn--ghost" href={url(install)}>{c.ctaSecondary}</a>
      <a class="btn btn--ghost" href={RELEASES_URL}>{c.ctaOther}</a>
      <a class="btn btn--ghost" href={REPO}><Fragment set:html={icon.GITHUB} />GitHub</a>
    </div>
    <p class="hero__note">{c.installNote}</p>
    <div class="window"><AppShell heading={c.shellHeading} task={c.shellTask} doc={c.shellDoc} client:visible /></div>
    <p class="caption">{c.shellCaption}</p>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>{c.layoutTitle}</h2>
      <p>{c.layoutBody}</p>
    </div>
    <WorkflowLayout copy={dictionaryFor(lang).diagrams} caption={c.layoutCaption} />
    <p class="link-row"><a href={url(guide + c.layoutLink.href)}>{c.layoutLink.label} →</a></p>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>{c.featuresTitle}</h2>
      <p>{c.featuresBody}</p>
    </div>
    <div class="card-grid">
      {c.cards.map((card) => (
        <a class="card" href={url(guide + card.href)}>
          <span class="card__icon"><Icon name={card.icon} /></span>
          <strong>{card.title}</strong>
          <span>{card.body}</span>
          <span class="card__more">→</span>
        </a>
      ))}
    </div>
    <p class="link-row">
      {c.moreLinks.map((l) => <a href={url(guide + l.href)}>{l.label} →</a>)}
    </p>
  </section>

  <section class="section">
    <div class="split split--rev">
      <div>
        <div class="term">
          <div class="term__bar"><span class="term__dots"><i></i><i></i><i></i></span> tasty</div>
          <pre><code><span class="g">$</span> tasty list info
<span class="g">$</span> tasty list workspaces
<span class="g">$</span> tasty list surfaces</code></pre>
        </div>
        <p class="caption term-caption">{c.agentsCaption}</p>
      </div>
      <div class="section__head" style="margin-bottom:0">
        <h2>{c.agentsTitle}</h2>
        <p set:html={c.agentsBody} />
        <p>{c.agentsIntegration}</p>
        <p class="caption">{c.agentsNote}</p>
        <p class="link-row">
          {c.agentsLinks.map((l) => <a href={url(guide + l.href)}>{l.label} →</a>)}
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <h2>{c.platformTitle}</h2>
      <p>{c.platformBody}</p>
    </div>
    <div class="platform-row">
      <span class="platform"><Fragment set:html={icon.WINDOWS} />Windows</span>
      <span class="platform"><Fragment set:html={icon.APPLE} />macOS</span>
      <span class="platform"><Fragment set:html={icon.LINUX} />Linux</span>
    </div>
  </section>

  <section class="cta-band">
    <h2>{c.ctaTitle}</h2>
    <p>{c.ctaBody}</p>
    <div class="cta-row">
      <a class="btn btn--primary" href={RELEASES_URL}>{c.ctaDownload}</a>
      <a class="btn btn--ghost" href={url(install)}>{c.ctaInstall}</a>
    </div>
  </section>

</main>
