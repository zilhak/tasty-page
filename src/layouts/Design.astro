---
/** Keep design examples at their intended widths in a wider content column. */
import Base from "./Base.astro";
import { DESIGN_NAV, GALLERY_GROUPS, designPath, galleryPath } from "../lib/design";
import { LANGS } from "../lib/langs.mjs";
import { stringsFor } from "../lib/strings";
import { url } from "../lib/site";
import "../styles/design.css";

interface Props {
  /** A language code from lib/langs.mjs. */
  lang: string;
  /** Slug of the page being rendered, so the sidebar can mark it current. */
  current: string;
  title: string;
  /** Lead paragraph on the page. May hold inline HTML. */
  intro: string;
  /** Plain-text search and share summary, kept apart from the longer intro. */
  description: string;
  /** Sections of the current page, listed under it in the sidebar. */
  sections?: { id: string; label: string }[];
}
const { lang, current, title, intro, description, sections = [] } = Astro.props;
const s = stringsFor(lang);
---
<Base
  lang={lang}
  title={`${title} · Tasty Design System`}
  description={description}
  active="design"
  hrefs={Object.fromEntries(LANGS.map((row) => [row.code, designPath(current, row.code)]))}
>
  <slot name="head" slot="head" />
  <div class="layout layout--design">
    <aside class="sidebar" aria-label={s.navDesign}>
      {DESIGN_NAV.map((group) => (
        <details class="nav-section" open>
          <summary>{group.group}</summary>
          <ul class="nav-list">
            {group.pages.map((page) => (
              <li>
                <a href={url(designPath(page.slug, lang))}
                   aria-current={page.slug === current ? "page" : undefined}
                   style="--indent:0">
                  {page.label}
                  <span class="nav-desc">{page.desc}</span>
                </a>
                {page.slug === current && sections.length > 0 && (
                  <ul class="nav-list nav-list--sections">
                    {sections.map((n) => <li><a href={`#${n.id}`} style="--indent:1">{n.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </details>
      ))}

      <details class="nav-section" open>
        <summary>Gallery</summary>
        <ul class="nav-list">
          {GALLERY_GROUPS.flatMap((g) => g.pages).map((page) => (
            <li>
              <a href={url(galleryPath(page.slug, lang))} style="--indent:0">
                {page.label}
                <span class="nav-desc">{page.desc}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </aside>

    <main class="content content--design" id="content">
      <header class="design-head">
        <p class="design-head__kicker">Tasty Design System</p>
        <h1>{title}</h1>
        <p class="design-head__intro" set:html={intro} />
      </header>
      <slot />
    </main>
  </div>
</Base>
