---
import Base from "../../layouts/Base.astro";
import Landing from "../../components/Landing.astro";
import meta from "../../lib/meta.json";
import { url } from "../../lib/site";
import { landingJsonLd } from "../../lib/structured-data";
---
<Base lang="ko" title={meta.ko.title} description={meta.ko.description} enHref="" koHref="ko/">
  <Fragment slot="head">
    <link rel="stylesheet" href={url("design/kit.css")} />
    <script is:inline type="application/ld+json" set:html={landingJsonLd("ko")} />
  </Fragment>
  <Landing lang="ko" />
</Base>
