---
/** `/design/` — the guideline cards, minus the token-system page's own route. */
import Design from "../../layouts/Design.astro";
import Cards from "./Cards.astro";
import { cards } from "../../lib/guidelines";
import { GALLERY_GROUPS, designPath, galleryPath } from "../../lib/design";
import { url } from "../../lib/site";
import type { Lang } from "../../lib/guide";

interface Props { lang: Lang; }
const { lang } = Astro.props;

const COPY = {
  en: {
    title: "Design foundations",
    intro:
      "Explore Tasty’s colours, typography, spacing, and components. These examples are references " +
      "for understanding and contributing to the design. The example documents and gallery are in " +
      "English. For app usage, see the user guide.",
    source: "View source:",
    guide: "User guide",
    tokens: "Design tokens",
    openGallery: "Open gallery (English)",
    groups: undefined,
    galleryTitle: "Explore the components",
    galleryBody:
      "Find examples in Foundations, Components, Overlays, Shell, and Surfaces. Each specimen starts " +
      "with its purpose, followed by Demo, States, Views, and Specs where content is available. Try " +
      "the demo, compare states and views, then check dimensions and tokens in the always-visible " +
      "Specs. The gallery is in English.",
  },
  ko: {
    title: "디자인 살펴보기",
    intro:
      "Tasty의 색, 글꼴, 간격과 컴포넌트 구성을 살펴보세요. 디자인을 이해하거나 기여할 때 참고하는 " +
      "예시입니다. 예시 문서와 갤러리는 영어로 제공합니다. 앱 사용법은 사용자 가이드에서 설명합니다.",
    source: "원본 보기:",
    guide: "사용자 가이드",
    tokens: "디자인 토큰",
    openGallery: "갤러리 보기(영어)",
    groups: { Brand: "브랜드", Colors: "색", Type: "글꼴", Spacing: "간격" } as Record<string, string>,
    galleryTitle: "컴포넌트 직접 살펴보기",
    galleryBody:
      "Foundations, Components, Overlays, Shell, Surfaces에서 필요한 예시를 찾으세요. 각 표본은 사용 " +
      "목적에 이어 Demo, States, Views, Specs 순서로 구성되며, 내용이 있는 부분만 표시합니다. 데모를 " +
      "조작하고 상태와 화면 예시를 비교한 뒤, 항상 표시되는 Specs에서 크기와 토큰을 확인할 수 있습니다. " +
      "갤러리는 영어로 제공합니다.",
  },
};
const c = COPY[lang];
const all = cards(process.cwd()).filter((x) => x.group !== "Tokens");
---
<Design lang={lang} current="" title={c.title} intro={c.intro}>
  <section class="ds-group">
    <h2>{c.galleryTitle}</h2>
    <p class="ds-lede">{c.galleryBody}</p>
    <p class="ds-links">
      <a href={url(lang === "en" ? "guide/" : "ko/guide/")}>{c.guide}</a>
      <a href={url(designPath("tokens/", lang))}>{c.tokens}</a>
      <a href={url(galleryPath(""))}>{c.openGallery}</a>
    </p>
    <ul class="ds-tiles">
      {GALLERY_GROUPS.flatMap((g) => g.pages).map((page) => (
        <li>
          <a href={url(galleryPath(page.slug))}>
            <span class="ds-tiles__label">{page.label}</span>
            <span class="ds-tiles__desc">{page.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Cards cards={all} sourceLabel={c.source} groupLabels={c.groups} />
</Design>
