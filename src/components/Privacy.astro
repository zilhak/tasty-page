---
/** Privacy notice page. Keep the dictionaries' `privacy` copy in step with
 * Analytics.astro: changing what the site collects or who processes it means
 * changing that copy in every language. Body values are HTML. */
import { dictionaryFor } from "../lib/i18n/index.mjs";
import { stringsFor } from "../lib/strings";
import { REPO } from "../lib/site";

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const p = dictionaryFor(lang).privacy;
const CLOUDFLARE_POLICY = "https://www.cloudflare.com/privacypolicy/";
const GITHUB_POLICY = "https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement";
const ISSUES = `${REPO}/issues`;
---
<div class="page-single">
  <main class="content" id="content">
    <article class="prose">
      <h1>{stringsFor(lang).privacyTitle}</h1>
      <p>{p.updated}</p>
      <p set:html={p.intro} />
      <h2>{p.collectedTitle}</h2>
      <p set:html={p.collectedBody} />
      <h2>{p.notUsedTitle}</h2>
      <p set:html={p.notUsedBody} />
      <h2>{p.handlersTitle}</h2>
      <p set:html={p.handlersBody} />
      <ul>
        <li><a href={CLOUDFLARE_POLICY}>{p.cloudflarePolicy}</a></li>
        <li><a href={GITHUB_POLICY}>{p.githubPolicy}</a></li>
      </ul>
      <h2>{p.retentionTitle}</h2>
      <p set:html={p.retentionBody} />
      <h2>{p.appTitle}</h2>
      <p set:html={p.appBody} />
      <h2>{p.contactTitle}</h2>
      <p set:html={p.contactBody.replace("{issues}", ISSUES)} />
    </article>
  </main>
</div>
