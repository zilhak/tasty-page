---
/** Document shell: head, header bar, footer — shared by the guide and the landings. */
import "../styles/tokens.css";
import "../styles/global.css";
import { DEFAULT_LANG, LANGS, langRow } from "../lib/langs.mjs";
import { stringsFor } from "../lib/strings";
import { REPO, absolute, url } from "../lib/site";
import { releaseVersion } from "../lib/release";
import Analytics from "../components/Analytics.astro";
import * as icon from "../components/icons";

interface Props {
  /** A language code from lib/langs.mjs. */
  lang: string;
  title: string;
  description: string;
  /** Which top-nav item to mark as current. */
  active?: "guide" | "install" | "design" | null;
  /** This page's path per language code. The language switch lists the languages present here. */
  hrefs: Record<string, string>;
  /** Open Graph type of the page. */
  ogType?: "website" | "article";
  /** Value of the robots meta tag. Without it the page has no such tag. */
  robots?: string;
  /** Whether to tell search engines about the other language paths. The language switch lists them either way. */
  announceLanguages?: boolean;
}
const { lang, title, description, active = null, hrefs, ogType = "website", robots, announceLanguages = true } = Astro.props;
const s = stringsFor(lang);
const current = langRow(lang);
if (hrefs[current.code] === undefined) {
  throw new Error(`hrefs has no path for this page's language ${current.code}: ${title}`);
}
const version = releaseVersion(process.cwd());
const guidePrefix = current.guide;
const landing = url(current.landing);
const mark = (name: string) => (active === name ? "page" : undefined);
const canonical = absolute(hrefs[current.code]);
const listed = LANGS.filter((row) => hrefs[row.code] !== undefined);
const hasOtherLanguage = announceLanguages && listed.length > 1;
const defaultHref = hrefs[DEFAULT_LANG];
const D2CODING_SOURCE = "https://github.com/naver/d2-coding-font";
---
<html lang={s.lang} data-theme-default="mocha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tasty" />
    <meta property="og:locale" content={current.ogLocale} />
    {hasOtherLanguage && listed.filter((row) => row !== current).map((row) => (
      <meta property="og:locale:alternate" content={row.ogLocale} />
    ))}
    <meta property="og:image" content={absolute(current.shareImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url("tasty-melon.svg")} type="image/svg+xml" />
    {hasOtherLanguage && (
      <>
        {listed.map((row) => <link rel="alternate" hreflang={row.code} href={absolute(hrefs[row.code])} />)}
        {defaultHref !== undefined && <link rel="alternate" hreflang="x-default" href={absolute(defaultHref)} />}
      </>
    )}
    <script is:inline>
      /* Apply the saved theme while parsing the document head. Without one the page stays Mocha, whatever the system prefers. */
      (function () {
        try {
          var saved = localStorage.getItem("tasty-theme");
          if (saved === "latte" || saved === "light") {
            document.documentElement.setAttribute("data-theme", "latte");
            return;
          }
          if (saved === "mocha" || saved === "dark") return;
        } catch (e) {}
      })();
    </script>
    <noscript>
      <style is:inline>
        /* The drawer needs a script. Without one the header keeps its links in a second row. */
        @media (max-width: 900px) {
          html .site-header { position: static; flex-wrap: wrap; height: auto; min-height: var(--header-h); padding-block: var(--sp-2); }
          html .site-nav { display: flex; order: 3; flex-basis: 100%; margin-left: 0; overflow-x: auto; }
        }
      </style>
    </noscript>
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="visually-hidden" href="#content">{s.skipToContent}</a>

    <header class="site-header" data-site-chrome>
      <button class="icon-btn menu-btn" type="button" aria-label={s.siteNav} aria-expanded="false">
        <Fragment set:html={icon.MENU} />
      </button>
      <a class="brand" href={landing}>
        <img class="brand__mark" src={url("tasty-melon.svg")} alt="" width="24" height="24" />
        <span>Tasty</span>
        {version && <span class="brand__version">v{version}</span>}
      </a>
      <nav class="site-nav" aria-label={s.siteNav}>
        <a href={url(guidePrefix)} aria-current={mark("guide")}>{s.navGuide}</a>
        <a href={url(`${guidePrefix}getting-started/install/`)} aria-current={mark("install")}>{s.navInstall}</a>
        <a href={`${REPO}/releases/latest`}>{s.navDownload}</a>
        <a href={url(`${current.prefix}design/`)} aria-current={mark("design")}>{s.navDesign}</a>
        <a href={`${REPO}/blob/main/CHANGELOG.md`}>{s.navChangelog}</a>
      </nav>
      <div class="header-tools">
        <div class="search">
          <label class="visually-hidden" for="site-search">{s.searchPlaceholder}</label>
          <span class="search__icon" aria-hidden="true"><Fragment set:html={icon.SEARCH} /></span>
          <input id="site-search" type="search" autocomplete="off" spellcheck="false"
                 placeholder={s.searchPlaceholder}
                 data-index={url(current.searchIndex)}
                 data-base={import.meta.env.BASE_URL}
                 data-empty-label={s.searchEmpty} />
          <div class="search__results" role="listbox"></div>
        </div>
        <details class="lang-switch">
          <summary class="icon-btn lang-switch__toggle">
            <span class="lang-switch__icon" aria-hidden="true"><Fragment set:html={icon.GLOBE} /></span>
            <span class="visually-hidden">{s.language}{" "}</span>
            <span class="lang-switch__current" lang={current.code}>{current.label}</span>
            <span class="lang-switch__icon lang-switch__chevron" aria-hidden="true"><Fragment set:html={icon.CHEVRON_DOWN} /></span>
          </summary>
          <ul class="lang-switch__menu">
            {listed.map((row) => (
              <li>
                <a href={url(hrefs[row.code])} hreflang={row.code} lang={row.code} data-lang={row.code} aria-current={row === current ? "true" : undefined}>
                  {row.label}
                  {row === current && <span class="lang-switch__icon" aria-hidden="true"><Fragment set:html={icon.CHECK} /></span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
        <button class="icon-btn theme-toggle" type="button" aria-label={s.toggleTheme}>
          <Fragment set:html={icon.MOON} /><Fragment set:html={icon.SUN} />
        </button>
        <a class="icon-btn" href={REPO} aria-label="GitHub"><Fragment set:html={icon.GITHUB} /></a>
      </div>
    </header>

    <slot />

    <footer class="site-footer" data-site-chrome>
      <div class="site-footer__inner">
        <div>
          <a class="brand" href={landing}>
            <img class="brand__mark" src={url("tasty-melon.svg")} alt="" width="24" height="24" />
            <span>Tasty</span>
          </a>
          <p class="site-footer__blurb">{s.footerBlurb}</p>
        </div>
        <div>
          <h4>{s.footerDocs}</h4>
          <ul>
            <li><a href={url(guidePrefix)}>{s.navGuide}</a></li>
            <li><a href={url(`${guidePrefix}getting-started/install/`)}>{s.navInstall}</a></li>
            <li><a href={url(`${guidePrefix}customize/keybindings/`)}>{s.footerKeybindings}</a></li>
            <li><a href={url(`${guidePrefix}plugins/`)}>{s.footerPlugins}</a></li>
          </ul>
        </div>
        <div>
          <h4>{s.footerProject}</h4>
          <ul>
            <li><a href={REPO}>GitHub</a></li>
            <li><a href={`${REPO}/releases/latest`}>{s.footerReleases}</a></li>
            <li><a href={`${REPO}/issues`}>{s.footerIssues}</a></li>
            <li><a href={`${REPO}/blob/main/CHANGELOG.md`}>{s.navChangelog}</a></li>
            <li><a href={url(current.privacy)}>{s.footerPrivacy}</a></li>
          </ul>
        </div>
      </div>
      <p class="site-footer__legal">{s.footerNote}</p>
      <p class="site-footer__font">
        <span>{s.footerFontNote} <a href={url("fonts/D2Coding-OFL.txt")}>{s.footerFontLicense}</a></span>
        <span>{s.footerFontSource} <a href={D2CODING_SOURCE}>{D2CODING_SOURCE}</a></span>
      </p>
    </footer>

    <script src="../scripts/site.js"></script>
  </body>
</html>
