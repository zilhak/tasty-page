---
import Base from "../../layouts/Base.astro";
import Landing from "../../components/Landing.astro";
import { dictionaryFor } from "../../lib/i18n/index.mjs";
import { hrefsFor } from "../../lib/langs.mjs";
import { url } from "../../lib/site";
import { landingJsonLd } from "../../lib/structured-data";
const meta = dictionaryFor("ko").meta;
---
<Base lang="ko" title={meta.title} description={meta.description} hrefs={hrefsFor((row) => row.landing)}>
  <Fragment slot="head">
    <link rel="stylesheet" href={url("design/kit.css")} />
    <script is:inline type="application/ld+json" set:html={landingJsonLd("ko")} />
  </Fragment>
  <Landing lang="ko" />
</Base>
