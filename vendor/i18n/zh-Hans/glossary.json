  "style": {
    "common": [
      "Use terse, technical, developer-to-developer language without marketing claims, exclamation marks or emoji, for example `连接失败。`.",
      "Omit the subject wherever Chinese allows it; when a personal pronoun is unavoidable, use `你` and never `您`, for example `选择工作区。`.",
      "Use full-width punctuation in Chinese sentences and half-width punctuation inside commands, paths, code and backtick spans, for example ``运行 `tasty list`。``.",
      "Insert one half-width space between Han characters and adjacent Latin letters, digits, placeholders or backtick spans, with no spaces next to full-width punctuation, for example `Surface 的 ID：{id}。`.",
      "Let explicit cell-width and table-header constraints override spacing, for example `工作区ID` in a constrained table header.",
      "Use Simplified Chinese and mainland Chinese software terminology, for example `软件、文件夹、剪贴板。`.",
      "Never translate commands, flags, argument IDs, allowed-value tokens, paths or placeholders; glossary translations apply only to running prose, so write `附加工作区` but preserve `tasty remote attach`.",
      "Keep operating system names Windows, macOS and Linux in Latin letters, for example `在 Windows 上运行。`; translate lowercase windows referring to operating system windows as `窗口`."
    ],
    "ui": [
      "Write buttons and menu items as bare verb phrases, for example `打开终端` and `添加插件`.",
      "Write labels and column headers as noun phrases, for example `工作区名称` and `连接状态`.",
      "End complete sentences with 。 and leave fragments without a period, for example `连接已断开。` versus `连接失败`.",
      "Use 请 only for an action that recovers from a problem, for example `请重新连接后重试。`; omit it from routine instructions such as `选择工作区。`."
    ],
    "cli_help": [
      "Use the same terse technical voice as UI text, compressed further into subjectless verb-object phrases, for example `列出工作区`.",
      "Avoid 请 and omit 你 wherever possible, for example `指定目标 Surface ID`.",
      "Preserve the source distinction between fragments and sentences, for example `工作区 ID` versus `未找到工作区。`.",
      "Do not add explanations, examples or inferred behavior, for example translate List hooks as `列出钩子`."
    ],
    "agent_plugin": [
      "Prefer literal precision over fluency and preserve every condition, operation order and limit, for example `仅在连接失败时重试，最多 3 次。`.",
      "Translate must as 必须, must not as 不得, should as 应 and may as 可以, for example `必须指定工作区 ID。`.",
      "Do not use 请, soften requirements or add explanations, for example `不得关闭父 Surface。`."
    ],
    "macos_menu": [
      "Use native Simplified Chinese macOS menu wording rather than general UI paraphrases, for example `最小化`.",
      "Translate About {} as `关于 {}` and Hide {} as `隐藏 {}`; macOS inserts a space before a Latin application name such as Tasty, so these forms follow the common spacing rule.",
      "Translate Hide Others as `隐藏其他` and Show All as `全部显示`.",
      "Translate Quit {} as `退出 {}`, File as `文件` and New Window as `新建窗口`.",
      "Translate Window as `窗口`, Minimize as `最小化`, Zoom as `缩放` and Close Window as `关闭窗口`."
    ]
  },
